# ParTraceflow MES — Production Environment Template (Docker Compose)
#
# Used by docker-compose.yml's `app` service (env_file). Copy this file to
# `.env.production.example` is committed as a template — for a real
# deployment, copy it to `.env.production` (gitignored) and fill in real
# values, or set these as real secrets in your orchestrator/hosting platform.
#
# DATABASE_URL, SESSION_SECRET, CRON_SECRET, and MQTT_* are intentionally
# NOT set here — docker-compose.yml injects those directly from mes-app/.env
# (POSTGRES_USER/POSTGRES_PASSWORD/SESSION_SECRET/CRON_SECRET/MQTT_USERNAME/
# MQTT_PASSWORD) so they stay in one place and docker-compose fails fast with
# a clear error if they're missing, instead of silently deploying with weak
# defaults.

NODE_ENV=production

# ── File Uploads (Vercel Blob) ────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Upstash Redis (required for distributed rate limiting across replicas) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS — set to your real domain, do not leave unset in production ──────
ALLOWED_ORIGIN="https://your-factory-domain.com"

# ── Email notifications (optional) ────────────────────────────────────────
# MES_EMAIL_WEBHOOK_URL="https://api.sendgrid.com/v3/mail/send"
# MES_EMAIL_FROM="mes@factory.local"

# ── Simulation — must stay disabled in production ─────────────────────────
MES_ENABLE_SIMULATION=0
