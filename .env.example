# ParTraceflow MES — Environment Configuration
# Copy this file to .env and fill in the values.

# ── Database (PostgreSQL required) ────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/partraceflow"

# ── Docker Compose only: Postgres container credentials ───────────────────
# REQUIRED when using docker-compose.yml. Never use the "postgres"/"postgres"
# defaults outside of throwaway local testing — set unique, random values.
# Must match the credentials embedded in DATABASE_URL above when both are
# in play (docker-compose builds DATABASE_URL from these at container start).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE"

# ── Authentication ─────────────────────────────────────────────────────────
# REQUIRED: Generate a unique secret for each deployment.
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE"

# ── Cron / scheduled job secret ───────────────────────────────────────────
CRON_SECRET="CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE"

# ── File Uploads (Vercel Blob) ────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Upstash Redis (for distributed rate limiting) ─────────────────────────
# Required in production for multi-instance deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────
# ALLOWED_ORIGIN="https://your-factory-domain.com"

# ── Email notifications (optional) ────────────────────────────────────────
# MES_EMAIL_WEBHOOK_URL="https://api.sendgrid.com/v3/mail/send"
# MES_EMAIL_FROM="mes@factory.local"

# ── MQTT Broker (optional — enables live telemetry) ───────────────────────
# MQTT_BROKER_URL="mqtt://localhost:1883"
# REQUIRED alongside MQTT_BROKER_URL for the docker-compose mosquitto broker,
# which rejects anonymous connections. Must match the credentials generated
# into deploy/mosquitto/passwordfile (see deploy/README.md).
# MQTT_USERNAME=""
# MQTT_PASSWORD=""

# ── Simulation (disabled by default — enable for testing only) ────────────
# MES_ENABLE_SIMULATION=1

# ── Docker Compose only: scheduled database backups (deploy/backup/) ──────
# Optional — both have defaults (24h interval, 14-day retention) if unset.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14
