}

model FillerBatch {
  id              String       @id @default(cuid())
  batchNumber     String       @unique
  classification  String?
  diameter        Float?
  lotNumber       String?
  supplier        String?
  receivedDate    DateTime?
  expiryDate      DateTime?
  storageLocation String?
  quantity        Float?
  unit            String?
  certPath        String?
  isActive        Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  weldRecords     WeldRecord[]
}

model PWHTCycle {
  id               String    @id @default(cuid())
  cycleNumber      String?
  spoolId          String
  spool            PipeSpool @relation(fields: [spoolId], references: [id])
  furnaceId        String?
  chargeNumber     String?
  heatingRate      Float?
  soakTemp         Float?
  soakDuration     Int?
  coolingRate      Float?
  startAt          DateTime?
  endAt            DateTime?
  operator         String?
  hardnessBefore   Float?
  hardnessAfter    Float?
  chartsPath       String?
  result           String    @default("PENDING")
  approved         Boolean   @default(false)
  approvedBy       String?
  // Real FK alongside the display-name string above (kept for historical/
  // external-approver compatibility) — approvedBy on this model is always
  // session-derived (see app/api/pipe-spool/pwht/route.ts), so a real
  // relation is safe and enables actual "what did this user approve" joins.
  approvedByUserId String?
  approvedByUser   User?     @relation("PWHTApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  // MEDIUM fix: same missing-uniqueness gap as WeldRecord.weldNumber above.
  @@unique([spoolId, cycleNumber])
}

model PressureTestLoop {
  id              String               @id @default(cuid())
  loopNumber      String               @unique
  description     String?
  testType        String               @default("HYDRO")
  testMedium      String?
  designPressure  Float?
  testPressure    Float?
  holdTime        Int?
  blindFlange     String?
  gaugeId         String?
  witnessedBy     String?
  clientWitness   String?
  status          String               @default("PENDING")
  scheduledDate   DateTime?
  testedAt        DateTime?
  certificateNo   String?
  certificatePath String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  spools          PipeSpool[]
  testRecords     PressureTestRecord[]
}

model MDR {
  id               String     @id @default(cuid())
  mdrNumber        String     @unique
  title            String?
  revision         String?
  projectRef       String?
  status           String     @default("DRAFT")
  preparedBy       String?
  preparedByUserId String?
  preparedByUser   User?      @relation("MDRPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedBy       String?
  reviewedByUserId String?
  reviewedByUser   User?      @relation("MDRReviewedBy", fields: [reviewedByUserId], references: [id])
  approvedBy       String?
  approvedByUserId String?
  approvedByUser   User?      @relation("MDRApprovedBy", fields: [approvedByUserId], references: [id])
  preparedAt       DateTime?
  reviewedAt       DateTime?
  approvedAt       DateTime?
  submittedAt      DateTime?
  filePath         String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  mdrSpools        MDRSpool[]
}

model MDRSpool {
  id      String    @id @default(cuid())
  mdrId   String
  mdr     MDR       @relation(fields: [mdrId], references: [id])
  spoolId String
  spool   PipeSpool @relation(fields: [spoolId], references: [id])
  addedAt DateTime  @default(now())

  @@unique([mdrId, spoolId])
}

// ── Phase 4 — Production Integrity Layer ─────────────────────────────────────

model AuditChain {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  userId       String?
  previousHash String
  currentHash  String
  payload      String
  timestamp    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

model ElectronicSignature {
  id          String   @id @default(cuid())
  userId      String
  entityType  String
  entityId    String
  reason      String
  ipAddress   String?
  timestamp   DateTime @default(now())
  // Industry-readiness: SHA-256 hash of the canonical JSON of the record
  // state at the moment it was signed. Lets verifySignatureForEntity()
  // detect whether the record changed between signing and the approval
  // action actually committing — previously a signature only proved *who*
  // signed *something* for this entity, not that it matched what's being
  // approved right now.
  payloadHash String?

  @@index([entityType, entityId])
  @@index([userId])
}

// ── Phase 8 — MQTT Runtime Ingestion ─────────────────────────────────────────

// Active alarm events from shop-floor MQTT; deduplicated per machine+code
model AlarmEvent {
  id             String    @id @default(cuid())
  machineId      String
  machine        Machine   @relation(fields: [machineId], references: [id])
  alarmCode      String
  severity       String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  message        String?
  startTime      DateTime  @default(now())
  endTime        DateTime?
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?

  @@index([machineId, acknowledged])
  @@index([machineId, alarmCode, endTime])
}

// OPC-UA / MQTT signal-to-MES field mapping per machine
model MachineSignalMap {
  machineId  String
  machine    Machine @relation(fields: [machineId], references: [id])
  signalName String
  mqttTopic  String
  opcNodeId  String?
  dataType   String // FLOAT | INT | BOOL | STRING
  isRequired Boolean @default(false)

  @@id([machineId, signalName])
  @@index([mqttTopic])
}

// ── Phase 10 — Industrial Historian ──────────────────────────────────────────

// Append-only time-series record for every tagged signal value received
model HistorianRecord {
  id             String   @id @default(cuid())
  machineId      String
  machine        Machine  @relation(fields: [machineId], references: [id])
  signalType     String // STATUS | COUNT | REJECT | TEMPERATURE | ALARM | DOWNTIME | OEE
  tagName        String
  value          String // stored as string; consumers parse per dataType
  quality        String   @default("GOOD") // GOOD | BAD | UNCERTAIN
  timestamp      DateTime @default(now())
  source         String // MQTT | OPCUA | EDGE_DEVICE | SYSTEM
  retentionClass String   @default("HOT") // HOT | WARM | COLD

  @@index([machineId, timestamp])
  @@index([timestamp, retentionClass])
  @@index([machineId, signalType, timestamp])
}

// ── Phase 9 — Edge Gateway Connectivity ──────────────────────────────────────

// Physical or virtual edge gateway/PLC device on the shop floor
model EdgeDevice {
  id               String          @id @default(cuid())
  name             String
  deviceType       String // PLC | OPCUA_GATEWAY | MQTT_GATEWAY | SENSOR_NODE
  ipAddress        String
  port             Int
  protocol         String // OPCUA | MQTT | MODBUS | REST
  status           String          @default("OFFLINE") // ONLINE | OFFLINE | ERROR
  lastSeen         DateTime?
  plantId          String?
  plant            Plant?          @relation(fields: [plantId], references: [id])
  productionLineId String?
  productionLine   ProductionLine? @relation(fields: [productionLineId], references: [id])
  tagMaps          PLCTagMap[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([plantId])
  @@index([productionLineId])
}

// Tag-to-machine signal mapping for a PLC or OPC-UA gateway device
model PLCTagMap {
  id           String     @id @default(cuid())
  edgeDeviceId String
  edgeDevice   EdgeDevice @relation(fields: [edgeDeviceId], references: [id])
  machineId    String
  machine      Machine    @relation(fields: [machineId], references: [id])
  tagName      String
  mqttTopic    String?
  opcNodeId    String?
  signalType   String // STATUS | COUNT | REJECT | TEMPERATURE | ALARM | DOWNTIME
  dataType     String // FLOAT | INT | BOOL | STRING
  scaleFactor  Float?
  enabled      Boolean    @default(true)

  @@unique([edgeDeviceId, tagName])
  @@index([machineId])
  @@index([edgeDeviceId, enabled])
}

// ── Phase 11 — Finite-Capacity Production Scheduling ─────────────────────────

// Production calendar: defines working days, shifts, holidays, maintenance windows
model ProductionCalendar {
  id                 String   @id @default(cuid())
  name               String
  calendarType       String // PLANT | LINE | MACHINE
  timezone           String   @default("UTC")
  workingDays        String // JSON: [1,2,3,4,5]  (0=Sun … 6=Sat)
  shiftPattern       String // JSON: [{name,startHour,startMin,endHour,endMin}]
  holidayRules       String? // JSON: [{date:"YYYY-MM-DD",name:"..."}]
  maintenanceWindows String? // JSON: [{start:ISO,end:ISO,label:"..."}]
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Per-machine capability: constrains which work orders can run on which machine
model MachineCapability {
  id                 String  @id @default(cuid())
  machineId          String
  machine            Machine @relation(fields: [machineId], references: [id])
  capabilityType     String // e.g., WELDING | CUTTING | ASSEMBLY | PAINTING
  productCode        String? // null = applies to all products
  maxCapacityPerHour Float // units per hour at 100% efficiency
  idealCycleTime     Float // seconds per unit (canonical cycle time)
  enabled            Boolean @default(true)

  @@unique([machineId, capabilityType, productCode])
  @@index([machineId, enabled])
}

// Finite-capacity schedule record: one per work order + machine assignment
model ProductionSchedule {
  id                       String    @id @default(cuid())
  workOrderId              String
  workOrder                WorkOrder @relation(fields: [workOrderId], references: [id])
  machineId                String
  machine                  Machine   @relation(fields: [machineId], references: [id])
  plannedStart             DateTime
  plannedEnd               DateTime
  estimatedDurationMinutes Float
  status                   String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | DRIFTED
  actualStart              DateTime?
  actualEnd                DateTime?
  driftMinutes             Float     @default(0)
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([machineId, plannedStart])
  @@index([workOrderId])
  @@index([status, plannedStart])
}

// Detected scheduling conflicts — persisted for querying and resolution
model SchedulingConflict {
  id           String     @id @default(cuid())
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])
  machineId    String?
  machine      Machine?   @relation(fields: [machineId], references: [id])
  conflictType String // MACHINE_OVERBOOKED | SHIFT_OVERBOOKED | MAINTENANCE_CONFLICT | MACHINE_DOWN | CAPABILITY_MISMATCH
  severity     String     @default("CRITICAL") // CRITICAL | WARNING | INFO
  description  String
  isBlocking   Boolean    @default(true)
  detectedAt   DateTime   @default(now())
  resolvedAt   DateTime?

  @@index([workOrderId])
  @@index([machineId, resolvedAt])
  @@index([conflictType, resolvedAt])
}

// ── Phase 12 — Product Master, BOM, Routing ───────────────────────────────────

// Bill of Materials header — one BOM per product per revision
model BillOfMaterial {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  revision    String    @default("A")
  description String?
  isActive    Boolean   @default(true)
  items       BOMItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, revision])
  @@index([productId, isActive])
}

// BOM line item — one row per component required
model BOMItem {
  id            String         @id @default(cuid())
  bomId         String
  bom           BillOfMaterial @relation(fields: [bomId], references: [id])
  componentCode String // references Product.sku of the component
  description   String?
  quantity      Float // must be > 0
  unitOfMeasure String         @default("EA")
  scrapFactor   Float? // fractional allowance e.g. 0.05 = 5% extra

  @@unique([bomId, componentCode])
  @@index([bomId])
  @@index([componentCode])
}

// Routing header — ordered sequence of manufacturing operations for a product
model Routing {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  routingCode String             @unique
  description String?
  revision    String             @default("A")
  isActive    Boolean            @default(true)
  operations  RoutingOperation[]
  workOrders  WorkOrder[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([productId, isActive])
}

// Individual operation within a routing
model RoutingOperation {
  id                    String  @id @default(cuid())
  routingId             String
  routing               Routing @relation(fields: [routingId], references: [id])
  operationCode         String
  operationName         String
  sequence              Int // execution order; unique per routing
  machineCapabilityType String // maps to MachineCapability.capabilityType
  estimatedCycleTime    Float // minutes per unit
  setupTime             Float   @default(0) // minutes
  inspectionRequired    Boolean @default(false)
  requiredSkill         String? // operator skill code

  @@unique([routingId, sequence])
  @@unique([routingId, operationCode])
  @@index([routingId])
  @@index([machineCapabilityType])
}

// Material consumption record per work order — actual vs planned per component
model MaterialConsumption {
  id              String    @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  componentCode   String // references Product.sku of the consumed component
  plannedQuantity Float
  actualQuantity  Float     @default(0)
  scrapQuantity   Float     @default(0)
  issuedAt        DateTime  @default(now())
  issuedBy        String?

  @@index([workOrderId])
  @@index([productId])
  @@index([componentCode])
}
