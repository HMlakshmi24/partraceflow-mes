model WelderQualification {
  id              String    @id @default(cuid())
  welderName      String
  welderStamp     String    @unique
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  qualifiedWpsIds String[]
  qualifiedWps    WPS[]
  processes       String[]
  positions       String[]
  materialGroups  String[]
  thicknessMin    Float?
  thicknessMax    Float?
  diameterMin     Float?
  diameterMax     Float?
  qualifiedAt     DateTime?
  expiresAt       DateTime?
  renewedAt       DateTime?
  isActive        Boolean   @default(true)
  certificateNo   String?
  certificatePath String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model HeatNumber {
  id               String                @id @default(cuid())
  heatNo           String                @unique
  material         String?
  grade            String?
  spec             String?
  size             String?
  supplier         String?
  millName         String?
  receivedDate     DateTime?
  quantity         Float?
  unit             String?
  quarantined      Boolean               @default(false)
  quarantineReason String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  spools           PipeSpool[]
  certificates     MaterialCertificate[]
}

model MaterialCertificate {
  id           String     @id @default(cuid())
  certNumber   String     @unique
  heatNumberId String
  heatNumber   HeatNumber @relation(fields: [heatNumberId], references: [id])
  certType     String     @default("MTR")
  supplier     String?
  mill         String?
  issuedDate   DateTime?
  receivedDate DateTime?
  chemComp     Json?
  mechProps    Json?
  filePath     String?
  verified     Boolean    @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
